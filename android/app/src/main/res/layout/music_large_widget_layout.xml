<?xml version="1.0" encoding="utf-8"?>
<!-- 2x3 Music widget (Obsidian Music's media card): cover behind a scrim,
     title over artist, previous / play-pause / next along the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/music_widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/music_widget_art_placeholder"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_music_note" />

    <ImageView
        android:id="@+id/music_widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Best Music"
            android:textColor="#A6FFFFFF"
            android:textSize="11sp" />

        <!-- Pushes the song and the buttons to the bottom (a FrameLayout:
             RemoteViews can't inflate a plain View). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/music_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nothing playing"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/music_widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tap to open Best Music"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/music_widget_previous"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="Previous"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/music_widget_play_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/widget_play_bg"
                android:contentDescription="Play"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play_dark" />

            <ImageButton
                android:id="@+id/music_widget_next"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="Next"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
