<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network access (MP3 Downloader, Subscriptions, online song info and
         the in-app update check) in release builds; debug/profile get it
         implicitly via their manifests. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updates: the install permission and the install-session
         receiver come from the mfficiency_updates plugin's own manifest
         (merged at build time); nothing about them here. -->
    <!-- "All files access": the Music Player scans the music folder the user
         picks and the MP3 Downloader writes straight into it, instead of
         always being redirected to the app's private storage. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- The media notification and the "Filling in song info…" one. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Background playback foreground service + its media notification /
         lock-screen controls (audio_service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Keeps the background song-info search / BPM detection running while
         other apps are open (BackgroundWorkService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- usesCleartextTraffic: the music server is plain http on the home network
         (http://hally.local:4533, the MagicMirror Pi's Navidrome, or its IP), which
         Android blocks by default; a LAN IP can't be listed in a domain allow-list. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher">
        <!-- singleTask (not singleTop) and the default task affinity: there
             is only ever ONE MainActivity / Flutter engine. A launch from the
             home screen, the media notification, a widget or ShareActivity
             re-fronts that one instance and reaches it via onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Share-sheet entry, text only: a Spotify/Shazam/YouTube link or a
             "Song - Artist" line goes straight to the MP3 Downloader
             (lib/main.dart). A translucent trampoline (not MainActivity
             itself): the share sheet starts its target inside the sharing
             app's task, and a second MainActivity there would mean a second
             Flutter engine. ShareActivity forwards the share into the app's
             real task and finishes. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Home-screen widgets: Music 1x2, 1x3 and 2x3. -->
        <receiver
            android:name=".MusicMiniWidgetProvider"
            android:exported="true"
            android:label="@string/music_mini_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/music_mini_widget_info" />
        </receiver>
        <receiver
            android:name=".MusicControlsWidgetProvider"
            android:exported="true"
            android:label="@string/music_controls_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/music_controls_widget_info" />
        </receiver>
        <receiver
            android:name=".MusicLargeWidgetProvider"
            android:exported="true"
            android:label="@string/music_large_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/music_large_widget_info" />
        </receiver>
        <!-- The 2x3 widget's like / dislike / heart buttons. -->
        <receiver
            android:name=".MusicWidgetActionReceiver"
            android:exported="false" />
        <!-- Receives background taps from the home-screen widgets -->
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetBackgroundReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.BACKGROUND" />
            </intent-filter>
        </receiver>
        <service
            android:name="es.antonborri.home_widget.HomeWidgetBackgroundService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
        <!-- The widgets' play button: asks "Play out loud?" over the home
             screen when nothing is connected, else just plays
             (MusicPlayGuardActivity). See-through, its own task, never in
             Recents. -->
        <activity
            android:name=".MusicPlayGuardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- The Wear OS watch app's buttons (wear/ in this repo): play/pause,
             next, previous and volume messages from the watch, bound by Play
             services only while one arrives (WearCommandService). -->
        <service
            android:name=".WearCommandService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/music/command/"
                    android:scheme="wear" />
            </intent-filter>
        </service>
        <!-- Background song-info search (MusicMetadataEnricher): an ongoing
             "Filling in song info…" notification that keeps the process
             alive while other apps are in front. specialUse because no
             standard type fits (dataSync is capped at 6 h a day). -->
        <service
            android:name=".BackgroundWorkService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Looks up missing song metadata online and detects song tempo on the device, on the user's own music library" />
        </service>
        <!-- Background playback: notification + lock-screen media controls,
             headset buttons (audio_service). -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
