<?xml version="1.0" encoding="utf-8"?>
<!-- 2x3 Music widget (Obsidian Music's media card): cover behind a scrim,
     dislike / like / heart top right, title over artist, previous /
     play-pause / next along the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/music_widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/music_widget_art_placeholder"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:layout_marginBottom="36dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_music_note" />

    <ImageView
        android:id="@+id/music_widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <!-- "Best Music", then dislike / like / heart (top right). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Best Music"
                android:textColor="#A6FFFFFF"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/music_widget_dislike"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:contentDescription="Dislike and skip"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_thumb_down" />

            <ImageButton
                android:id="@+id/music_widget_like"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:contentDescription="Like"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_thumb_up" />

            <ImageButton
                android:id="@+id/music_widget_favorite"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:contentDescription="Add to Favorites"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_favorite" />
        </LinearLayout>

        <!-- Pushes the song and the buttons to the bottom (a FrameLayout:
             RemoteViews can't inflate a plain View). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/music_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nothing playing"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/music_widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tap to open Best Music"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/music_widget_previous"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="Previous"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/music_widget_play_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/widget_play_bg"
                android:contentDescription="Play"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play_dark" />

            <ImageButton
                android:id="@+id/music_widget_next"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="Next"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
